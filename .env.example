# Application : dev | test | prod (rien de sensible en l'état)
APP_ENV=dev

# Chemin de la base de données SQLite (relatif = CWD). Exemple : data/assistant-emploi.db
DATABASE_URL=sqlite:///data/assistant-emploi.db

# Clé secrète de session / jetons (32+ caractères en production)
# La première exécution génère une valeur aléatoire et la sauvegarde dans .env.
APP_SECRET=change-me-in-production

# URL de base de l'application (utilisée pour les liens email et webhooks)
APP_BASE_URL=http://localhost:8080
